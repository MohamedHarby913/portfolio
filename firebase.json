{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      { "source": "**/*.@(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(jpg|jpeg|png|webp|svg|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**/*.pdf", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
